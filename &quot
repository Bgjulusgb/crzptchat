"""
Configuration settings for the secure chat application
"""

import os
from pathlib import Path

# Base paths
BASE_DIR = Path(__file__).parent
DATA_DIR = BASE_DIR / "data"
KEYS_DIR = DATA_DIR / "keys"
UPLOADS_DIR = DATA_DIR / "uploads"

# Database settings
DATABASE_URL = f"sqlite:///{DATA_DIR / 'chat.db'}"

# Security settings
SECRET_KEY = os.getenv("SECRET_KEY", "your-secret-key-change-this-in-production")
JWT_SECRET_KEY = os.getenv("JWT_SECRET_KEY", "your-jwt-secret-key-change-this-in-production")
JWT_ALGORITHM = "HS256"
JWT_EXPIRATION_HOURS = 24

# Encryption settings
ENCRYPTION_KEY_ALGORITHM = "Fernet"
KEY_ROTATION_DAYS = 30

# Rate limiting
MAX_LOGIN_ATTEMPTS = 5
LOGIN_ATTEMPT_WINDOW = 300  # 5 minutes in seconds
MAX_MESSAGES_PER_MINUTE = 60

# File upload settings
MAX_FILE_SIZE = 10 * 1024 * 1024  # 10MB
ALLOWED_FILE_TYPES = {
    'text/plain', 'application/pdf', 'image/jpeg', 'image/png',
    'application/zip', 'text/csv'
}

# 2FA settings
2FA_ENABLED = True
2FA_ISSUER = "SecureChat"

# Session settings
SESSION_TIMEOUT_MINUTES = 30

# Create necessary directories
DATA_DIR.mkdir(exist_ok=True)
KEYS_DIR.mkdir(exist_ok=True, mode=0o700)  # Secure permissions
UPLOADS_DIR.mkdir(exist_ok=True)
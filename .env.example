# Secure Chat Application - Environment Configuration
# Copy this file to .env and customize the values

# ===========================================
# Security Settings
# ===========================================

# JWT Secret Key - WICHTIG: Ändere dies für Produktion!
# Generiere mit: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Algorithm
JWT_ALGORITHM=HS256

# JWT Token Expiration (in hours)
JWT_EXPIRATION_HOURS=24

# Refresh Token Validity (in days)
REFRESH_TOKEN_DAYS=30

# ===========================================
# Database Settings
# ===========================================

# Data Directory
SECURE_CHAT_DATA_DIR=secure_chat_data

# SQLite Database File (relative to DATA_DIR)
# For production, consider PostgreSQL or MySQL
DATABASE_URL=sqlite:///secure_chat_data/chat.db

# ===========================================
# Rate Limiting
# ===========================================

# Maximum login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Login attempt window (in seconds)
LOGIN_ATTEMPT_WINDOW=300

# Maximum messages per minute
MAX_MESSAGES_PER_MINUTE=60

# ===========================================
# File Upload Settings
# ===========================================

# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# File chunk size for uploads (64KB)
FILE_CHUNK_SIZE=65536

# ===========================================
# Message Settings
# ===========================================

# Maximum message length
MAX_MESSAGE_LENGTH=10000

# Message retention period (in days)
MESSAGE_RETENTION_DAYS=365

# ===========================================
# Pagination
# ===========================================

# Default page size for message/user lists
DEFAULT_PAGE_SIZE=50

# Maximum page size
MAX_PAGE_SIZE=100

# ===========================================
# Password Requirements
# ===========================================

# Minimum password length
MIN_PASSWORD_LENGTH=8

# ===========================================
# Flask Settings (for Web Server)
# ===========================================

# Flask environment (development/production)
FLASK_ENV=development

# Flask debug mode (True/False)
FLASK_DEBUG=True

# Flask host
FLASK_HOST=0.0.0.0

# Flask port
FLASK_PORT=5000

# ===========================================
# Logging
# ===========================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file (optional, logs to console if not set)
# LOG_FILE=secure_chat_data/logs/app.log

# ===========================================
# CORS Settings (for Web API)
# ===========================================

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# Production Settings (Example)
# ===========================================

# Uncomment and configure for production:

# JWT_SECRET=<generate-secure-random-key>
# FLASK_ENV=production
# FLASK_DEBUG=False
# DATABASE_URL=postgresql://user:password@localhost/securechat
# LOG_FILE=secure_chat_data/logs/app.log
# LOG_LEVEL=WARNING
# CORS_ORIGINS=https://yourdomain.com
